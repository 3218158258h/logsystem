  "<div class=\"slide\" data-layout=\"default\" data-template-slide=\"4\">\n                    <div class=\"slide-logo\"></div>\n                    <div class=\"slide-header\">\n                        <div class=\"slide-title\" contenteditable=\"true\">第一部分：课题公共知识培训总结</div>\n                        <div class=\"slide-divider\"></div>\n                    </div>\n                    <div class=\"slide-body\">\n                        <div class=\"grid-2\">\n                            <div class=\"col\">\n                                <div class=\"col-title\" contenteditable=\"true\">公共培训与工厂产线参观</div>\n                                <ul>\n                                    <li contenteditable=\"true\"><strong>安全、礼仪与文化培训：</strong>员工素质较好 企业鼓励创业</li>\n                                    <li contenteditable=\"true\"><strong>企业产品了解与园区参观：</strong>产品涉及较多领域 园区设施齐全</li>\n                                </ul>\n                            </div>\n                            <div class=\"col\">\n                                <div class=\"col-title\" contenteditable=\"true\">AI实践与工具配置</div>\n                                <ul>\n                                    <li contenteditable=\"true\"><strong>AI 辅助研发实践：</strong>使用 Codex 辅助实现与审查；用协作文档记录需求、计划和纠偏过程。</li>\n                                    <li contenteditable=\"true\"><strong>开发工具配置：</strong>完成 Ubuntu 下 Git、GCC/G++、CMake、Protobuf 与 FDBus 环境准备。</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"slide-footer\">\n                        <div contenteditable=\"true\">六环</div>\n                        <div>4</div>\n                    </div>\n                </div>\n\n                \n\n\n\n",
